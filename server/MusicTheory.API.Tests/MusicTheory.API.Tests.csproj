<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicTheory.API\MusicTheory.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frozen answers from the TypeScript decoder. Regenerate with
         `cd client && node tools/basic-pitch-vectors.cjs`. -->
    <None Update="Vectors\basic-pitch-vectors.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- What the TF.js graph returned for one window, frozen so this suite
         needs no Node, no browser and no GPU. Regenerate with
         `cd client && node tools/basic-pitch-reference.cjs
         ../server/MusicTheory.API.Tests/Vectors/basic-pitch-reference`. -->
    <None Update="Vectors\basic-pitch-reference\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- The library's own end-to-end result for six seconds of synthesised
         audio. Regenerate with `cd client && node tools/basic-pitch-pipeline.cjs
         ../server/MusicTheory.API.Tests/Vectors/basic-pitch-pipeline`. -->
    <None Update="Vectors\basic-pitch-pipeline\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
